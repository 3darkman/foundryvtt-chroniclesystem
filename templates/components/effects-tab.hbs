{{!-- Shared "Effects" tab — reused by every item sheet and actor sheet (DRY).
      Root is a <div class="tab"> (NEVER a nested <form> — V2). Columns follow the
      design §7: NAME | ORIGIN | STATUS | ACTIONS. Control visibility follows each
      effect's `editable` flag (permission model FR-021/SC-009). --}}
<div class="tab effects-tab" data-group="primary" data-tab="effects">
    <div class="effects-toolbar">
        <a class="effect-control effect-create" data-action="effectCreate" title="{{localize 'CS.effects.create'}}">
            <i class="fas fa-plus"></i> {{localize "CS.effects.create"}}
        </a>
    </div>
    <header class="effects-header">
        <span class="effect-col effect-col-name">{{localize "CS.effects.columns.name"}}</span>
        <span class="effect-col effect-col-origin">{{localize "CS.effects.columns.origin"}}</span>
        <span class="effect-col effect-col-status">{{localize "CS.effects.columns.status"}}</span>
        <span class="effect-col effect-col-actions">{{localize "CS.effects.columns.actions"}}</span>
    </header>
    <ol class="effects-list list">
        {{#each effects as |effect|}}
        <li class="effect item {{#if effect.disabled}}effect-disabled{{/if}}" data-effect-id="{{effect.id}}">
            <div class="effect-cell-name">
                <span class="effect-name">{{effect.name}}</span>
            </div>
            <span class="effect-origin-name">{{localize (concat "CS.effects.origin." effect.originKind)}}{{#if effect.sourceName}}: {{effect.sourceName}}{{/if}}</span>
            <span class="effect-status">
                <span class="effect-status-badge is-{{effect.displayState}}">
                    {{localize (concat "CS.effects.status." effect.displayState)}}
                </span>
            </span>
            <div class="effect-controls flexrow">
                {{#if effect.isSuppressed}}
                {{!-- Suspended is derived from the unequipped source item: no reactivate
                      toggle — a non-interactive icon carries the cause (FR-024/FR-025). --}}
                <i class="effect-suspended-icon fas fa-link-slash" title="{{localize 'CS.effects.status.suspendedHint'}}"></i>
                {{#if effect.editable}}
                <a class="effect-control" data-action="effectEdit" data-effect-id="{{effect.id}}" title="{{localize 'CS.effects.edit'}}">
                    <i class="fas fa-edit"></i>
                </a>
                <a class="effect-control effect-delete" data-action="effectDelete" data-effect-id="{{effect.id}}" title="{{localize 'CS.effects.delete'}}">
                    <i class="fas fa-times"></i>
                </a>
                {{else}}
                <i class="effect-lock fas fa-lock" title="{{localize 'CS.effects.locked'}}"></i>
                {{/if}}
                {{else if effect.editable}}
                <a class="effect-control effect-toggle {{#unless effect.disabled}}is-on{{/unless}}" data-action="effectToggle" data-effect-id="{{effect.id}}" title="{{localize 'CS.effects.toggle'}}">
                    <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
                </a>
                <a class="effect-control" data-action="effectEdit" data-effect-id="{{effect.id}}" title="{{localize 'CS.effects.edit'}}">
                    <i class="fas fa-edit"></i>
                </a>
                <a class="effect-control effect-delete" data-action="effectDelete" data-effect-id="{{effect.id}}" title="{{localize 'CS.effects.delete'}}">
                    <i class="fas fa-times"></i>
                </a>
                {{else}}
                <i class="effect-lock fas fa-lock" title="{{localize 'CS.effects.locked'}}"></i>
                {{/if}}
            </div>
        </li>
        {{else}}
        <li class="effect-empty">{{localize "CS.effects.empty"}}</li>
        {{/each}}
    </ol>
</div>
