{{!-- spec 025 (US1) — Visão Geral. Derived values are read-only SPANS, never
      `readonly` inputs: since v13 a readonly input IS submitted, and a derived
      stat carrying a `name` would be written straight back into the document.
      Only Health's current value and the two GM modifiers (Defence, Movement)
      are editable — they are the only persisted fields in this tab. --}}
<div class="tab unit-overview-tab" data-group="primary" data-tab="overview">
    {{!-- The four Training bands as a single-select chip group — the shared
          `.csv2-chip-group` radio primitive, NOT the item sheet's field-cell:
          that cell is a GRID cell (its left hairline is only cancelled by
          `.csv2-field-grid > :nth-child(3n+1)`), so standalone it draws a stray
          rule and takes a third of the row. --}}
    <section class="cs-unit-section">
        <h2 class="cs-unit-section-title">{{localize "CS.sheets.unit.training"}}</h2>
        <div class="csv2-chip-group cs-unit-training">
            {{#each trainingChoices as |label level|}}
            <label class="csv2-chip {{#ifEquals level @root.unit.trainingLevel}}is-selected{{/ifEquals}}">
                <input type="radio" name="system.trainingLevel" value="{{level}}" {{#ifEquals level @root.unit.trainingLevel}}checked{{/ifEquals}} />
                {{localize label}}
            </label>
            {{/each}}
        </div>
    </section>

    <div class="cs-unit-columns">
        <section class="csv2-card cs-unit-stats">
            <div class="csv2-card-header">{{localize "CS.sheets.unit.calculatedValues"}}</div>

            <div class="cs-unit-stat">
                <span class="csv2-label">{{localize "CS.sheets.unit.health"}}</span>
                <span class="cs-unit-stat-pair">
                    <input class="is-mono cs-unit-current" type="text" name="system.health.value" value="{{unit.health.value}}" data-dtype="Number" />
                    <span class="cs-unit-derived">/ {{unit.health.max}}</span>
                </span>
            </div>

            <div class="cs-unit-stat">
                <span class="csv2-label">{{localize "CS.sheets.unit.combatDefense"}}</span>
                <span class="cs-unit-stat-pair">
                    <span class="cs-unit-derived">{{combatDefense.value}}</span>
                    <span class="cs-unit-operator">+</span>
                    <input class="is-mono" type="text" name="system.derivedStats.combatDefense.modifier" value="{{combatDefense.modifier}}" data-dtype="Number" />
                    <span class="cs-unit-operator">=</span>
                    <span class="cs-unit-derived cs-unit-total">{{combatDefense.total}}</span>
                </span>
            </div>

            <div class="cs-unit-stat">
                <span class="csv2-label">{{localize "CS.sheets.unit.discipline"}}</span>
                <span class="cs-unit-derived cs-unit-total">{{discipline}}</span>
            </div>

            <div class="cs-unit-stat">
                <span class="csv2-label">{{localize "CS.sheets.unit.movement"}}</span>
                {{#if hasMovement}}
                <span class="cs-unit-stat-pair">
                    <span class="cs-unit-derived">{{unit.movement.base}}</span>
                    <span class="cs-unit-operator">&minus;</span>
                    <span class="cs-unit-derived">{{unit.movement.bulk}}</span>
                    <span class="cs-unit-operator">+</span>
                    <input class="is-mono" type="text" name="system.movement.modifier" value="{{unit.movement.modifier}}" data-dtype="Number" />
                    <span class="cs-unit-operator">=</span>
                    <span class="cs-unit-derived cs-unit-total">{{unit.movement.total}}</span>
                </span>
                {{else}}
                <span class="cs-unit-empty">{{localize "CS.sheets.unit.noMovement"}}</span>
                {{/if}}
            </div>

            <div class="cs-unit-stat">
                <span class="csv2-label">{{localize "CS.sheets.unit.powerCost"}}</span>
                <span class="cs-unit-derived cs-unit-total">{{powerCost}}</span>
            </div>
        </section>

        <section class="csv2-card cs-unit-equipment">
            <div class="csv2-card-header">{{localize "CS.sheets.unit.equipment"}}</div>
            {{#if equipment}}
            <div class="cs-unit-equipment-source">{{equipment.typeName}}</div>

            <div class="cs-unit-equipment-block">
                <span class="csv2-label">{{localize "CS.sheets.unit.armor"}}</span>
                <span class="cs-unit-armor-values">
                    <span class="cs-unit-derived" data-tooltip="{{localize 'CS.sheets.item.fields.rating'}}">{{equipment.armor.rating}}</span>
                    <span class="cs-unit-derived" data-tooltip="{{localize 'CS.sheets.item.fields.penalty'}}">{{equipment.armor.penalty}}</span>
                    <span class="cs-unit-derived" data-tooltip="{{localize 'CS.sheets.item.fields.bulk'}}">{{equipment.armor.bulk}}</span>
                </span>
                <label class="csv2-switch cs-unit-evolve" data-tooltip="{{localize 'CS.sheets.unit.evolveHint'}}">
                    <input type="checkbox" name="system.evolvedEquipment.armor" {{#if equipment.armorEvolved}}checked{{/if}} />
                    <span class="csv2-switch-track"></span>
                    <span class="cs-unit-evolve-label">{{localize "CS.sheets.unit.evolve"}}</span>
                </label>
            </div>

            {{#each equipment.weapons as |weapon|}}
            <div class="cs-unit-equipment-block">
                <span class="csv2-label">{{localize weapon.label}}</span>
                {{#if weapon.chip}}
                {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs" id=weapon.chip.id label=weapon.chip.label}}
                {{/if}}
                {{#if weapon.total}}
                <span class="cs-unit-derived cs-unit-total">{{weapon.total}}</span>
                {{/if}}
                <label class="csv2-switch cs-unit-evolve" data-tooltip="{{localize 'CS.sheets.unit.evolveHint'}}">
                    <input type="checkbox" name="system.evolvedEquipment.{{weapon.key}}" {{#if weapon.evolved}}checked{{/if}} />
                    <span class="csv2-switch-track"></span>
                    <span class="cs-unit-evolve-label">{{localize "CS.sheets.unit.evolve"}}</span>
                </label>
                {{#if weapon.qualities.length}}
                <span class="cs-unit-quality-chips">
                    {{#each weapon.qualities as |quality|}}
                    <span class="cs2-tag {{#if quality.missing}}is-missing{{/if}}" {{#if quality.description}}data-tooltip="{{quality.description}}"{{/if}}>{{quality.name}}{{#if quality.parameter}} {{quality.parameter}}{{/if}}</span>
                    {{/each}}
                </span>
                {{/if}}
            </div>
            {{/each}}
            {{else}}
            <div class="csv2-list-empty">{{localize "CS.sheets.unit.noEquipment"}}</div>
            {{/if}}
        </section>
    </div>
</div>
