<div class="tab" data-group="primary" data-tab="sorcery">
    <div class="cs2-callout">
        <span class="cs2-callout-label">Sorcery Points</span>
        <div class="cs2-fraction">
            <input name="system.sorceryPoints.current" type="text" value="{{character.sorceryPoints.current}}" placeholder="Current" data-dtype="Number"/>
            <span class="cs2-op">/</span>
            <input name="system.sorceryPoints.max" type="text" value="{{character.sorceryPoints.max}}" placeholder="Max" data-dtype="Number"/>
        </div>
    </div>

    <div class="cs2-section-title"><span class="cs2-rail"></span><span>{{localize "CS.sheets.character.techniques"}}</span></div>

    {{#each character.owned.techniques as |technique|}}
        <div class="cs2-technique">
            <div class="item technique item-edit cs2-technique-header" data-item-id="{{_id}}" data-action="editItem"><a>{{technique.name}}</a></div>
            <div class="cs2-works">
                {{#each technique.system.works as |work|}}
                    <div class="item work cs2-work" data-item-id="{{_id}}">
                        <div class="cs2-work-head">
                            <b>{{work.name}}</b>
                            <span class="cs2-tag">{{localize (lookup ../../techniquesTypes work.type)}}</span>
                            <span class="cs2-work-cost">Cost {{localize (lookup ../../techniquesCosts work.cost)}}</span>
                            <div class="item-controls" data-action="toggleDescription"><a><i class="far fa-caret-square-down"></i></a></div>
                        </div>
                        {{#ifEquals work.type "SPELL"}}
                            {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                id=work.test.spellcastingChip.id
                                label=work.test.spellcastingChip.label }}
                        {{else}}
                            <div class="cs2-work-tests">
                                <div>
                                    <div class="cs2-work-test-label">{{localize "CS.sheets.techniqueItem.test.alignment"}}</div>
                                    {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                        id=work.test.alignmentChip.id
                                        label=work.test.alignmentChip.label }}
                                </div>
                                <div>
                                    <div class="cs2-work-test-label">{{localize "CS.sheets.techniqueItem.test.invocation"}}</div>
                                    {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                        id=work.test.invocationChip.id
                                        label=work.test.invocationChip.label }}
                                </div>
                                <div>
                                    <div class="cs2-work-test-label">{{localize "CS.sheets.techniqueItem.test.unleashing"}}</div>
                                    {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                        id=work.test.unleashingChip.id
                                        label=work.test.unleashingChip.label }}
                                </div>
                            </div>
                        {{/ifEquals}}
                        <p class="resonance"><b>{{localize "CS.sheets.techniqueItem.resonance"}}:</b> {{work.resonance}}</p>
                        <div class="description hidden">{{enrich work.description}}</div>
                    </div>
                {{/each}}
            </div>
        </div>
    {{/each}}
</div>
