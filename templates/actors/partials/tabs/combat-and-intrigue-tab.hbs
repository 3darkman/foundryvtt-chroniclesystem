<div class="tab" data-group="primary" data-tab="combat-and-intrigue">
    <div class="cs2-callout">
        <span class="cs2-callout-label">Destiny Points</span>
        <div class="cs2-fraction">
            <input name="system.destinyPoints.current" type="text" value="{{character.destinyPoints.current}}" placeholder="Current" data-dtype="Number"/>
            <span class="cs2-op">/</span>
            <input name="system.destinyPoints.max" type="text" value="{{character.destinyPoints.max}}" placeholder="Max" data-dtype="Number"/>
        </div>
    </div>

    <div class="cs2-columns">
        {{!-- ============================================================ INTRIGUE --}}
        <div class="cs2-card">
            <div class="cs2-card-header">Intrigue</div>

            {{> "systems/chroniclesystem/templates/components/stat-row.hbs"
                label="Intrigue Defense"
                value=character.derivedStats.intrigueDefense.value
                modifierName="system.derivedStats.intrigueDefense.modifier"
                modifierValue=character.derivedStats.intrigueDefense.modifier
                total=character.derivedStats.intrigueDefense.total }}

            {{> "systems/chroniclesystem/templates/components/stat-row.hbs"
                label="Composure"
                value=character.derivedStats.composure.value
                modifierName="system.derivedStats.composure.modifier"
                modifierValue=character.derivedStats.composure.modifier
                total=character.derivedStats.composure.total
                currentName="system.derivedStats.composure.current"
                current=character.derivedStats.composure.current }}

            <div class="cs2-track-block">
                <div class="cs2-track-label">Frustration</div>
                {{> (ratingCheckbox) max=character.derivedStats.frustration.total currentValue=character.derivedStats.frustration.current dataType="Frustration" }}
            </div>

            <div class="cs2-track-block">
                <div class="cs2-track-label">Stress</div>
                {{> (ratingCheckbox) max=2 currentValue=character.currentStress dataType="Stress" }}
            </div>

            <div class="cs2-card-header">Current Disposition</div>
            <div class="cs2-disposition-list">
                {{#each dispositions}}
                    <div class="disposition option capitalize {{showIfEquals this.rating ../character.currentDisposition "selected"}}" data-id="{{this.rating}}" data-action="changeDisposition">
                        <div class="cs2-disposition-row">
                            <span class="cs2-disposition-name">{{this.rating}} &middot; {{localize this.name}}</span>
                            <span class="cs2-disposition-mods">{{this.persuasionModifier}} / {{this.deceptionModifier}}</span>
                        </div>
                    </div>
                {{/each}}
            </div>

            <div class="cs2-card-header">Techniques</div>
            <div class="cs2-grid" style="grid-template-columns: 1fr auto auto auto">
                <span class="cs2-grid-head">Name</span>
                <span class="cs2-grid-head center">Influence</span>
                <span class="cs2-grid-head center">Persuasion</span>
                <span class="cs2-grid-head center">Deception</span>
                {{#each techniques}}
                <div class="cs2-row" style="display:contents">
                    <div class="cs2-grid-cell capitalize">{{this.name}}</div>
                    <div class="cs2-grid-cell center mono">{{this.influence}}</div>
                    <div class="cs2-grid-cell center">
                        {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                            id=this.persuasionChip.id
                            label=this.persuasionChip.label
                            rollKind="intrigue" techniqueSlug=@key influence=this.influence }}
                    </div>
                    <div class="cs2-grid-cell center">
                        {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                            id=this.deceptionChip.id
                            label=this.deceptionChip.label
                            rollKind="intrigue" techniqueSlug=@key influence=this.influence }}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        {{!-- ============================================================= COMBAT --}}
        <div class="cs2-card">
            <div class="cs2-card-header">Combat</div>

            {{> "systems/chroniclesystem/templates/components/stat-row.hbs"
                label="Combat Defense"
                value=character.derivedStats.combatDefense.value
                modifierName="system.derivedStats.combatDefense.modifier"
                modifierValue=character.derivedStats.combatDefense.modifier
                total=character.derivedStats.combatDefense.total }}

            {{> "systems/chroniclesystem/templates/components/stat-row.hbs"
                label="Health"
                value=character.derivedStats.health.value
                modifierName="system.derivedStats.health.modifier"
                modifierValue=character.derivedStats.health.modifier
                total=character.derivedStats.health.total
                currentName="system.derivedStats.health.current"
                current=character.derivedStats.health.current }}

            <div class="cs2-track-block">
                <div class="cs2-track-label">Fatigue</div>
                {{> (ratingCheckbox) max=character.derivedStats.fatigue.total currentValue=character.derivedStats.fatigue.current dataType="Fatigue" }}
            </div>

            <div class="cs2-track-block">
                <div class="cs2-track-label">Movement</div>
                <div class="cs2-stat-fields">
                    <input type="text" value="{{character.movement.base}}" placeholder="Base" readonly="readonly"/>
                    <span class="cs2-op">+</span>
                    <input type="text" value="{{character.movement.runBonus}}" placeholder="Run Bonus" readonly="readonly"/>
                    <span class="cs2-op">&minus;</span>
                    <input type="text" value="{{character.movement.bulk}}" placeholder="Bulk" readonly="readonly"/>
                    <span class="cs2-op">+</span>
                    <input name="system.movement.modifier" type="text" value="{{character.movement.modifier}}" placeholder="Modifier" data-dtype="Number"/>
                    <span class="cs2-op">=</span>
                    <span class="cs2-total">{{character.movement.total}}</span>
                </div>
            </div>

            <div class="cs2-split">
                <div>
                    <div class="cs2-card-header">
                        Injuries
                        <span class="cs2-count">{{currentInjuries}} / {{maxInjuries}}</span>
                    </div>
                    {{#each character.injuries as |injury id|}}
                        <div class="cs2-split-item flexrow">
                            <input type="text" name="system.injuries.{{id}}" value="{{injury}}" placeholder="Description" data-dtype="String"/>
                            <a class="cs2-icon-btn injury-control" data-id="{{id}}" data-action="deleteInjury"><i class="fas fa-trash"></i></a>
                        </div>
                    {{else}}
                        <div class="cs2-split-item cs2-split-empty">&mdash;</div>
                    {{/each}}
                    <a class="cs2-split-add injury-create" data-type="skill" data-action="createInjury"><i class="fa fa-plus"></i> Add</a>
                </div>
                <div>
                    <div class="cs2-card-header">
                        Wounds
                        <span class="cs2-count">{{currentWounds}} / {{maxWounds}}</span>
                    </div>
                    {{#each character.wounds as |wound id|}}
                        <div class="cs2-split-item flexrow">
                            <input type="text" name="system.wounds.{{id}}" value="{{wound}}" placeholder="Description" data-dtype="String"/>
                            <a class="cs2-icon-btn wound-control" data-id="{{id}}" data-action="deleteWound"><i class="fas fa-trash"></i></a>
                        </div>
                    {{else}}
                        <div class="cs2-split-item cs2-split-empty">&mdash;</div>
                    {{/each}}
                    <a class="cs2-split-add wound-create" data-type="skill" data-action="createWound"><i class="fa fa-plus"></i> Add</a>
                </div>
            </div>

            <div class="cs2-card-header">Equipped Weapons</div>
            <div class="cs2-grid" style="grid-template-columns: 1fr auto auto">
                <span class="cs2-grid-head">Weapon</span>
                <span class="cs2-grid-head center">Test</span>
                <span class="cs2-grid-head center">Dmg</span>
                {{#each character.owned.weapons as |weapon index|}}
                    {{#ifDifferent weapon.system.equipped ../notEquipped}}
                        <div class="cs2-row" style="display:contents">
                            <div class="cs2-grid-cell">{{weapon.name}} {{showIfEquals weapon.system.equipped 3 "(Off-hand)" : ""}}</div>
                            <div class="cs2-grid-cell center">
                                {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                    id=weapon.weaponChip.id
                                    label=weapon.weaponChip.label
                                    rollKind="weapon" itemId=weapon.id }}
                            </div>
                            <div class="cs2-grid-cell center mono">{{weapon.damageValue}}</div>
                        </div>
                    {{/ifDifferent}}
                {{/each}}
            </div>

            <div class="cs2-card-header">Equipped Armor</div>
            <div class="cs2-grid" style="grid-template-columns: 1fr auto auto">
                <span class="cs2-grid-head">Armor</span>
                <span class="cs2-grid-head center">Rating</span>
                <span class="cs2-grid-head center">Penalty</span>
                {{#each character.owned.armors as |armor index|}}
                    {{#ifDifferent armor.system.equipped ../notEquipped}}
                        <div class="cs2-row" style="display:contents">
                            <div class="cs2-grid-cell">{{armor.name}}</div>
                            <div class="cs2-grid-cell center mono">{{armor.system.rating}}</div>
                            <div class="cs2-grid-cell center mono muted">{{armor.system.penalty}}</div>
                        </div>
                    {{/ifDifferent}}
                {{/each}}
            </div>
        </div>
    </div>
</div>
