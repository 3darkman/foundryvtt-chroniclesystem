<div class="tab equipments" data-group="primary" data-tab="equipments">
    <div class="cs2-callout">
        <span class="cs2-callout-label">Currency</span>
        <div class="cs2-currency">
            <label>Copper <input id="system.coins.coppers" name="system.coins.coppers" type="text" value="{{character.coins.coppers}}" placeholder="Coppers" data-dtype="Number"/></label>
            <label>Silver <input id="system.coins.silvers" name="system.coins.silvers" type="text" value="{{character.coins.silvers}}" placeholder="Silvers" data-dtype="Number"/></label>
            <label>Gold <input id="system.coins.golds" name="system.coins.golds" type="text" value="{{character.coins.golds}}" placeholder="Golds" data-dtype="Number"/></label>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header">Weapons</div>
        <div class="cs2-grid-scroll">
        <div class="cs2-grid" style="grid-template-columns: 20px 0.9fr auto auto auto auto 2fr auto; min-width:640px">
            <span class="cs2-grid-head"></span>
            <span class="cs2-grid-head">Name</span>
            <span class="cs2-grid-head center">Test</span>
            <span class="cs2-grid-head center">Dmg</span>
            <span class="cs2-grid-head center">Weight</span>
            <span class="cs2-grid-head center">Cost</span>
            <span class="cs2-grid-head">Qualities</span>
            <span class="cs2-grid-head center">Eq</span>
            {{#each character.owned.weapons as |weapon index|}}
                <div class="item weapon cs2-row" data-item-id="{{_id}}" draggable="true" style="display:contents">
                    <div class="cs2-grid-cell"><i class="fas fa-grip-vertical cs2-drag-handle"></i></div>
                    <div class="cs2-grid-cell weapon-label item-edit" data-action="editItem"><a>{{weapon.name}}</a></div>
                    <div class="cs2-grid-cell center">
                        {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                            id=weapon.weaponChip.id
                            label=weapon.weaponChip.label
                            rollKind="weapon" itemId=weapon.id }}
                    </div>
                    <div class="cs2-grid-cell center mono weapon-damage">{{weapon.damageValue}}</div>
                    <div class="cs2-grid-cell center muted">{{weapon.system.weight}} lb</div>
                    <div class="cs2-grid-cell center muted">{{weapon.system.cost}}</div>
                    <div class="cs2-grid-cell cs2-tags">
                        {{#each weapon.system.qualities}}{{#if missing}}<span class="cs2-tag cs2-tag-missing" title="{{localize 'CS.quality.picker.missing'}}">{{#if slug}}{{slug}}{{else}}(empty){{/if}} · {{localize 'CS.quality.picker.missingItem'}}</span>{{else}}<span class="cs2-tag" {{#if description}}data-tooltip="{{description}}"{{/if}}>{{name}} {{parameter}}</span>{{/if}}{{/each}}
                    </div>
                    <div class="cs2-grid-cell center">
                        {{#if weapon.hasDefensive}}
                        <a class="checkButton cs-defensive {{#if weapon.stanceActive}}activated{{/if}}" data-item-id="{{_id}}" data-action="defensiveStance" title="{{localize 'CS.quality.defensiveStance'}}"><i class="fas fa-shield-halved"></i></a>
                        {{/if}}
                        <a class="checkButton equipped {{showIfContains "2|4" weapon.system.equipped "activated" ""}}" data-item-id="{{_id}}" data-hand="{{showIfContains "2|4" weapon.system.equipped 0 2}}" data-type="weapon" data-action="toggleEquipped"><i class="fa fa-hand-paper"></i></a>
                        <a class="checkButton equipped off-hand {{showIfContains "3|4" weapon.system.equipped "activated" ""}}" data-item-id="{{_id}}" data-hand="{{showIfContains "3|4" weapon.system.equipped 0 3}}" data-type="weapon" data-action="toggleEquipped"><i class="fa fa-hand-paper"></i></a>
                    </div>
                </div>
            {{/each}}
        </div>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header">Armors</div>
        <div class="cs2-grid-scroll">
        <div class="cs2-grid" style="grid-template-columns: 0.9fr auto auto auto auto auto 1.8fr auto; min-width:600px">
            <span class="cs2-grid-head">Name</span>
            <span class="cs2-grid-head center">Rating</span>
            <span class="cs2-grid-head center">Penalty</span>
            <span class="cs2-grid-head center">Bulk</span>
            <span class="cs2-grid-head center">Weight</span>
            <span class="cs2-grid-head center">Cost</span>
            <span class="cs2-grid-head">Qualities</span>
            <span class="cs2-grid-head center">Eq</span>
            {{#each character.owned.armors as |armor index|}}
                <div class="item weapon cs2-row" data-item-id="{{_id}}" draggable="true" style="display:contents">
                    <div class="cs2-grid-cell armor-label item-edit" data-action="editItem"><a>{{armor.name}}</a></div>
                    <div class="cs2-grid-cell center mono armor-rating">{{armor.system.rating}}</div>
                    <div class="cs2-grid-cell center mono muted armor-penalty">{{armor.system.penalty}}</div>
                    <div class="cs2-grid-cell center mono muted armor-bulk">{{armor.system.bulk}}</div>
                    <div class="cs2-grid-cell center muted">{{armor.system.weight}} lb</div>
                    <div class="cs2-grid-cell center muted">{{armor.system.cost}}</div>
                    <div class="cs2-grid-cell cs2-tags">
                        {{#each armor.system.qualities}}{{#if missing}}<span class="cs2-tag cs2-tag-missing" title="{{localize 'CS.quality.picker.missing'}}">{{#if slug}}{{slug}}{{else}}(empty){{/if}} · {{localize 'CS.quality.picker.missingItem'}}</span>{{else}}<span class="cs2-tag" {{#if description}}data-tooltip="{{description}}"{{/if}}>{{name}} {{parameter}}</span>{{/if}}{{/each}}
                    </div>
                    <div class="cs2-grid-cell center">
                        <a class="checkButton equipped {{showIfEquals "1" armor.system.equipped "activated" ""}}" data-item-id="{{_id}}" data-hand="{{showIfEquals "1" armor.system.equipped 0 1}}" data-type="armor" data-action="toggleEquipped"><i class="fas fa-shield-alt"></i></a>
                    </div>
                </div>
            {{/each}}
        </div>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header">Equipments</div>
        <div class="cs2-grid" style="grid-template-columns: 1fr auto auto">
            <span class="cs2-grid-head">Name</span>
            <span class="cs2-grid-head center">Quantity</span>
            <span class="cs2-grid-head center">Cost</span>
            {{#each character.owned.equipments as |equipment index|}}
                <div class="item equipment cs2-row" data-item-id="{{_id}}" draggable="true" style="display:contents">
                    <div class="cs2-grid-cell equipment-label item-edit" data-action="editItem"><a>{{equipment.name}}</a></div>
                    <div class="cs2-grid-cell center">{{equipment.system.quantity}}</div>
                    <div class="cs2-grid-cell center muted">{{equipment.system.cost}}</div>
                </div>
            {{/each}}
        </div>
    </div>
</div>
