<div class="tab description" data-group="primary" data-tab="actor-description">
    {{!-- spec 012 (US2): owner-only configure-public-sheet bar + instruction banner. --}}
    {{#if pub}}
    <div class="cs2-pub-bar">
        <h2 class="cs2-pub-title">{{localize "CS.sheets.character.tabs.description"}}</h2>
        <div class="cs2-pub-actions">
            <button type="button" class="cs2-pub-toggle" data-action="viewPublicSheet" title="{{localize "CS.sheets.character.visibility.viewTooltip"}}">
                <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                <span>{{localize "CS.sheets.character.visibility.view"}}</span>
            </button>
            <button type="button" class="cs2-pub-toggle{{#if pubMode}} on{{/if}}" data-action="togglePubMode">
                <svg width="13" height="13" aria-hidden="true"><use href="#ico-eye"></use></svg>
                <span>{{pubLabel}}</span>
            </button>
        </div>
    </div>
    {{#if pubMode}}
    <div class="cs2-pub-banner">
        <svg width="14" height="14" aria-hidden="true"><use href="#ico-eye"></use></svg>
        <span>{{localize "CS.sheets.character.visibility.banner"}}</span>
    </div>
    {{/if}}
    {{/if}}
    <div class="cs2-columns" style="grid-template-columns: 140px 1fr">
        <section class="profile-picture">
            <div class="profile-img-container flex">
                <center><img class="profile-img" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}" alt="{{actor.name}} Picture" /></center>
            </div>
        </section>

        <div class="cs2-card">
            <div class="cs2-card-header">Appearance</div>
            <div class="cs2-field-grid">
                <div class="form-group">
                    <label for="system.height">Height</label>
                    <span class="form-fields">
                        <input id="system.height" name="system.height" type="text" value="{{character.height}}" placeholder="Height" data-dtype="String"/>
                    </span>
                </div>
                <div class="form-group">
                    <label for="system.weight">Weight</label>
                    <span class="form-fields">
                        <input id="system.weight" name="system.weight" type="text" value="{{character.weight}}" placeholder="Weight" data-dtype="Number"/>
                    </span>
                </div>
                <div class="form-group">
                    <label for="system.eyeColor">Eye Color</label>
                    <span class="form-fields">
                        <input id="system.eyeColor" name="system.eyeColor" type="text" value="{{character.eyeColor}}" placeholder="Eye Color" data-dtype="String"/>
                    </span>
                </div>
                <div class="form-group">
                    <label for="system.hairColor">Hair Color</label>
                    <span class="form-fields">
                        <input id="system.hairColor" name="system.hairColor" type="text" value="{{character.hairColor}}" placeholder="Hair Color" data-dtype="String"/>
                    </span>
                </div>
            </div>
            <div class="cs2-field-grid" style="grid-template-columns: 1fr 1fr 1fr">
                <div class="form-group">
                    <label for="system.experience.spent">XP Spent</label>
                    <span class="form-fields">
                        <input id="system.experience.spent" name="system.experience.spent" type="text" value="{{character.experience.spent}}" placeholder="Spent" data-dtype="Number"/>
                    </span>
                </div>
                <div class="form-group">
                    <label for="system.experience.total">XP Total</label>
                    <span class="form-fields">
                        <input id="system.experience.total" name="system.experience.total" type="text" value="{{character.experience.total}}" placeholder="Total" data-dtype="Number"/>
                    </span>
                </div>
                <div class="form-group glory">
                    <label for="system.glory">Glory</label>
                    <span class="form-fields">
                        <input id="system.glory" name="system.glory" type="text" value="{{character.glory}}" placeholder="Current" data-dtype="Number"/>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header"><span>Identity</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.identity key="identity"}}</div>
        <div class="cs2-field-stack cs2-identity-grid">
            <div class="form-group">
                <label for="system.ancestries">Ancestry</label>
                <span class="form-fields">
                    <input id="system.ancestries" name="system.ancestries" type="text" value="{{character.ancestries}}" placeholder="Ancestry" data-dtype="String"/>
                </span>
            </div>
            <div class="form-group">
                <label for="system.gender">Gender</label>
                <span class="form-fields">
                    <input id="system.gender" name="system.gender" type="text" value="{{character.gender}}" placeholder="Gender" data-dtype="String"/>
                </span>
            </div>
            <div class="form-group">
                <label for="system.age">Age</label>
                <span class="form-fields">
                    <input id="system.age" name="system.age" type="text" value="{{character.age}}" placeholder="Age" data-dtype="Number"/>
                </span>
            </div>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header"><span>Concept</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.concept key="concept"}}</div>
        <div class="cs2-field-stack cs2-concept-grid">
            <div class="form-group">
                <label for="system.vice">Vice</label>
                <span class="form-fields">
                    <input id="system.vice" class="big-field" name="system.vice" type="text" value="{{character.vice}}" placeholder="Vice" data-dtype="String"/>
                </span>
            </div>
            <div class="form-group">
                <label for="system.virtue">Virtue</label>
                <span class="form-fields">
                    <input id="system.virtue" class="big-field" name="system.virtue" type="text" value="{{character.virtue}}" placeholder="Virtue" data-dtype="String"/>
                </span>
            </div>
            <div class="form-group">
                <label for="system.goal">Goal</label>
                <span class="form-fields">
                    <input id="system.goal" class="big-field" name="system.goal" type="text" value="{{character.goal}}" placeholder="Goal" data-dtype="String"/>
                </span>
            </div>
            <div class="form-group">
                <label for="system.motivation">Motivation</label>
                <span class="form-fields">
                    <input id="system.motivation" class="big-field" name="system.motivation" type="text" value="{{character.motivation}}" placeholder="Motivation" data-dtype="String"/>
                </span>
            </div>
        </div>
    </div>

    <div class="cs2-columns">
        <div class="cs2-card cs2-note-card">
            <div class="cs2-card-header"><span>Mannerisms</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.mannerisms key="mannerisms"}}</div>
            <div class="form-group">
                <span class="form-fields">
                    <input id="system.mannerisms" class="big-field" name="system.mannerisms" type="text" value="{{character.mannerisms}}" placeholder="Mannerisms" data-dtype="String"/>
                </span>
            </div>
        </div>
        <div class="cs2-card cs2-note-card">
            <div class="cs2-card-header"><span>Distinguishing Features</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.features key="features"}}</div>
            <div class="form-group">
                <span class="form-fields">
                    <input id="system.distinguishingFeatures" class="big-field" name="system.distinguishingFeatures" type="text" value="{{character.distinguishingFeatures}}" placeholder="Distinguishing Features" data-dtype="String"/>
                </span>
            </div>
        </div>
    </div>

    <div class="cs2-card">
        <div class="cs2-card-header"><span>Personal History</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.history key="history"}}</div>
        <div class="cs2-rich-text form-group">
            {{#if editable}}
            <prose-mirror name="system.personalHistory" button="true" toggled="true" value="{{character.personalHistory}}">
                {{{enrichedPersonalHistory}}}
            </prose-mirror>
            {{else}}
            <div class="editor-content">{{{enrichedPersonalHistory}}}</div>
            {{/if}}
        </div>
    </div>

    <div class="cs2-columns">
        <div class="cs2-card">
            <div class="cs2-card-header"><span>Allies</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.allies key="allies"}}</div>
            <div class="cs2-rich-text form-group">
                {{#if editable}}
                <prose-mirror name="system.allies" button="true" toggled="true" value="{{character.allies}}">
                    {{{enrichedAllies}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedAllies}}}</div>
                {{/if}}
            </div>
        </div>
        <div class="cs2-card">
            <div class="cs2-card-header"><span>Enemies</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.enemies key="enemies"}}</div>
            <div class="cs2-rich-text form-group">
                {{#if editable}}
                <prose-mirror name="system.enemies" button="true" toggled="true" value="{{character.enemies}}">
                    {{{enrichedEnemies}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedEnemies}}}</div>
                {{/if}}
            </div>
        </div>
        <div class="cs2-card">
            <div class="cs2-card-header"><span>Oaths</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.oaths key="oaths"}}</div>
            <div class="cs2-rich-text form-group">
                {{#if editable}}
                <prose-mirror name="system.oaths" button="true" toggled="true" value="{{character.oaths}}">
                    {{{enrichedOaths}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedOaths}}}</div>
                {{/if}}
            </div>
        </div>
        <div class="cs2-card">
            <div class="cs2-card-header"><span>Motto</span>{{> "systems/chroniclesystem/templates/actors/partials/pub-eye.hbs" state=pub.motto key="motto"}}</div>
            <div class="cs2-rich-text form-group">
                {{#if editable}}
                <prose-mirror name="system.motto" button="true" toggled="true" value="{{character.motto}}">
                    {{{enrichedMotto}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedMotto}}}</div>
                {{/if}}
            </div>
        </div>
    </div>
</div>
