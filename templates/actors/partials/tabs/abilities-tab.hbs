<div class="tab" data-group="primary" data-tab="abilities">
    <div class="cs2-card">
        <div class="cs2-card-header">{{localize "CS.sheets.character.tabs.abilities"}}</div>
        <div class="cs2-grid" style="grid-template-columns: minmax(96px, max-content) 150px 1fr">
            <span class="cs2-grid-head center">Test</span>
            <span class="cs2-grid-head">Ability</span>
            <span class="cs2-grid-head">Specialties</span>
            {{#each character.owned.abilities as |ability key|}}
                <div class="item ability cs2-row" data-item-id="{{ability._id}}" draggable="true" style="display:contents">
                    <div class="cs2-grid-cell center">
                        {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                            id=ability.abilityChip.id
                            label=ability.abilityChip.label }}
                    </div>
                    <div class="cs2-grid-cell">
                        <label class="ability-label item-edit" data-action="editItem"><a>{{ability.name}}</a></label>
                    </div>
                    <div class="cs2-grid-cell cs2-tags">
                        {{#each ability.system.specialties as |specialty key|}}
                            {{#if specialty.rating}}
                            {{> "systems/chroniclesystem/templates/components/rollable-chip.hbs"
                                id=specialty.specialtyChip.id
                                label=(concat specialty.name " " specialty.specialtyChip.label) }}
                            {{/if}}
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</div>
