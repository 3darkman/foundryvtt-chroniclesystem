{{!-- spec 025 (US1) — Descrição, rebuilt against the layout handoff: portrait on
      the left, the description as a card with a blue header on the right.
      `<prose-mirror>` is used directly (the legacy {{editor}} helper is NOT
      form-associated in v13/v14, so it would never auto-save); the template root
      is a <div>, never a <form>. --}}
<div class="tab unit-description-tab" data-group="primary" data-tab="description">
    <div class="cs2-section-title">
        <span class="cs2-rail"></span>
        <span>{{localize "CS.sheets.unit.identity"}}</span>
    </div>
    <div class="cs-unit-description-layout">
        <img class="profile-img cs-unit-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage"
             title="{{actor.name}}" alt="{{actor.name}}" />
        <div class="cs2-card cs-unit-description-body">
            <div class="cs2-card-header">{{localize "CS.sheets.unit.description"}}</div>
            <prose-mirror name="system.description" button="true" toggled="true" value="{{unit.description}}">
                {{{enrichedDescription}}}
            </prose-mirror>
        </div>
    </div>
</div>
