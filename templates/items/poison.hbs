<section class="{{cssClass}}">
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-group="primary" data-tab="details" data-action="tab">{{localize "CS.sheets.generalLabels.details"}}</a>
        <a class="item" data-group="primary" data-tab="effects" data-action="tab">{{localize "CS.effects.tab"}}</a>
    </nav>
    <div class="tab" data-group="primary" data-tab="details">
    {{!-- Item Sheet Header --}} {{>
    "systems/chroniclesystem/templates/items/partials/header.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            <div class="form-group">
                <label for="system.delivery">Delivery:</label>
                <span class="form-fields">
                  <input
                          class="small-field"
                          name="system.delivery"
                          type="text"
                          value="{{item.system.delivery}}"
                          placeholder="Delivery"
                          data-dtype="String"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.virulence">Virulence:</label>
                <span class="form-fields">
                  <input
                          class="small-field"
                          name="system.virulence"
                          type="text"
                          value="{{item.system.virulence}}"
                          placeholder="Virulence"
                          data-dtype="String"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.frequency">Frequency:</label>
                <span class="form-fields">
                  <input
                          class="small-field"
                          name="system.frequency"
                          type="text"
                          value="{{item.system.frequency}}"
                          placeholder="Frequency"
                          data-dtype="String"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.toxicity">Toxicity:</label>
                <span class="form-fields">
                  <input
                          class="small-field"
                          name="system.toxicity"
                          type="text"
                          value="{{item.system.toxicity}}"
                          placeholder="Toxicity"
                          data-dtype="Number"
                  />
                </span>
            </div>
            <div class="form-group">
                <label for="system.diagnosis">Diagnosis:</label>
                <span class="form-fields">
                  <input
                          class="small-field"
                          name="system.diagnosis"
                          type="text"
                          value="{{item.system.diagnosis}}"
                          placeholder="Diagnosis"
                          data-dtype="Number"
                  />
                </span>
            </div>
            {{> "systems/chroniclesystem/templates/items/partials/physical-item.hbs"}}
        </section>
        <section class="poison">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
            <header class="header-field">
                <span>Effects</span>
            </header>
            <div class="form-group">
                {{#if editable}}
                <prose-mirror name="system.effects" button="true" toggled="true" value="{{item.system.effects}}">
                    {{{enrichedEffects}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedEffects}}}</div>
                {{/if}}
            </div>
            <header class="header-field">
                <span>Recovery</span>
            </header>
            <div class="form-group">
                {{#if editable}}
                <prose-mirror name="system.recovery" button="true" toggled="true" value="{{item.system.recovery}}">
                    {{{enrichedRecovery}}}
                </prose-mirror>
                {{else}}
                <div class="editor-content">{{{enrichedRecovery}}}</div>
                {{/if}}
            </div>
        </section>
    </main>
    </div>
    {{> "systems/chroniclesystem/templates/components/effects-tab.hbs"}}
</section>
