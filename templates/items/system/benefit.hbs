{{!-- Benefício (benefit) Sistema body (spec 019). --}}
<section class="tab {{#if tab.active}}active{{/if}}" data-group="primary" data-tab="system">
    <div class="csv2-card">
        <div class="csv2-card-header">{{localize (concat "TYPES.Item." item.type)}}</div>
        <div class="csv2-field-grid">
            {{> "systems/chroniclesystem/templates/items/components/field-cell.hbs" kind="text" name="system.categories" label="CS.sheets.item.fields.categories" value=item.system.categories}}
            {{> "systems/chroniclesystem/templates/items/components/field-cell.hbs" kind="text" name="system.requirements" label="CS.sheets.item.fields.requirements" value=item.system.requirements}}
            {{> "systems/chroniclesystem/templates/items/components/field-cell.hbs" kind="bool" name="system.sorcerousArtAccess" label="CS.sheets.item.fields.sorcerousArtAccess" value=item.system.sorcerousArtAccess}}
        </div>
    </div>
</section>
