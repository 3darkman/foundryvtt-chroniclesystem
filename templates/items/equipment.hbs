<section class="{{cssClass}}">
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-group="primary" data-tab="details" data-action="tab">{{localize "CS.sheets.generalLabels.details"}}</a>
        <a class="item" data-group="primary" data-tab="effects" data-action="tab">{{localize "CS.effects.tab"}}</a>
    </nav>
    <div class="tab" data-group="primary" data-tab="details">
    {{!-- Item Sheet Header --}} {{>
"systems/chroniclesystem/templates/items/partials/header-delete.hbs"}}
    <main class="sheet-body flexrow">
        <section class="item-stats">
            <header class="header-field">
                <span>{{localize "CS.sheets.generalLabels.details"}}</span>
            </header>
            {{> "systems/chroniclesystem/templates/items/partials/equipment-item.hbs"}}
        </section>
        <section class="description">
            {{> "systems/chroniclesystem/templates/items/partials/description.hbs"}}
        </section>
    </main>
    </div>
    {{> "systems/chroniclesystem/templates/components/effects-tab.hbs"}}
</section>
