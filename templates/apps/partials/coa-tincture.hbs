{{!-- Reusable tincture control (FR-004, design handoff). Context = a tincture
      descriptor. Tintura mode: swatch grid + hex row. Padrão/Semy (advanced):
      head + colour1/colour2/size selects that build the composite string. --}}
<div class="coa-tincture">
  <div class="coa-tincture-head">
    <span class="csv2-label">{{label}}</span>
    {{#if advanced}}
    <div class="csv2-segmented">
      <button type="button" class="{{#if segTintura}}is-active{{/if}}" data-action="setTinctMode" data-path="{{path}}" data-mode="tintura">{{localize "CS.coa.fields.modeTincture"}}</button>
      <button type="button" class="{{#if segPadrao}}is-active{{/if}}" data-action="setTinctMode" data-path="{{path}}" data-mode="padrao">{{localize "CS.coa.fields.modePattern"}}</button>
      <button type="button" class="{{#if segSemy}}is-active{{/if}}" data-action="setTinctMode" data-path="{{path}}" data-mode="semy">{{localize "CS.coa.fields.modeSemyShort"}}</button>
    </div>
    {{/if}}
  </div>

  {{#if isTintura}}
  <div class="coa-swatches">
    {{#each swatches}}
      <button type="button" class="csv2-swatch {{#if this.selected}}is-selected{{/if}}"
              style="background:{{this.color}}"
              data-action="setTincture" data-path="{{../path}}" data-tincture="{{this.key}}"
              title="{{this.label}}"></button>
    {{/each}}
  </div>
  <div class="coa-tincture-hex">
    <span class="coa-hex-swatch" style="background:{{hex}}"></span>
    <span class="coa-hex-name">{{selLabel}}</span>
    <input type="text" class="coa-hex-input" data-coa="{{path}}" data-live value="{{hex}}" />
    <a class="coa-hex-reset" data-action="restoreTincture" data-path="{{path}}" title="{{localize 'CS.coa.actions.restoreDefault'}}"><svg width="13" height="13"><use href="#coa-ico-reset"></use></svg></a>
  </div>
  {{/if}}

  {{#if isPatternish}}
  <div class="coa-pattern" data-tinct-path="{{path}}" data-tinct-mode="{{mode}}">
    <label class="coa-field">
      <span class="coa-sub-label">{{headLabel}}</span>
      <select data-tinct-part="head">
        {{#each headOptions}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
      </select>
    </label>
    <div class="coa-three-col">
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.color1"}}</span>
        <select data-tinct-part="t1">{{#each color1}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.color2"}}</span>
        <select data-tinct-part="t2">{{#each color2}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.size"}}</span>
        <select data-tinct-part="size">{{#each sizeOptions}}<option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></label>
    </div>
  </div>
  {{/if}}
</div>
