{{!-- Ordinary inspector — visual type grid + size + tincture + line grid (linear). --}}
<div class="coa-field">
  <div class="csv2-label">{{localize "CS.coa.fields.ordinary"}} · 35</div>
  <div class="coa-shield-grid coa-division-grid">
    {{#each ordinaryCells}}
      <button type="button" class="coa-shield-cell {{#if this.selected}}is-selected{{/if}}"
              data-action="selectOrdinary" data-ordinary="{{this.key}}" title="{{this.label}}">
        {{{this.svg}}}
        <span class="coa-shield-name">{{this.label}}</span>
      </button>
    {{/each}}
  </div>
</div>

<label class="coa-field">
  <span class="csv2-label">{{localize "CS.coa.fields.size"}}</span>
  <input type="number" step="0.1" min="0.1" data-coa="ordinaries.{{index}}.size"
         data-dtype="Number" data-optional data-live value="{{o.size}}" placeholder="1.0" />
</label>

{{> "systems/chroniclesystem/templates/apps/partials/coa-tincture.hbs" tincture}}

{{#if lined}}
<div class="coa-field">
  <div class="csv2-label">{{localize "CS.coa.fields.line"}} · 33</div>
  <div class="coa-shield-grid coa-line-grid">
    {{#each lineCells}}
      <button type="button" class="coa-shield-cell {{#if this.selected}}is-selected{{/if}}"
              data-action="selectLine" data-line="{{this.key}}" title="{{this.label}}">
        {{{this.svg}}}
        <span class="coa-shield-name">{{this.label}}</span>
      </button>
    {{/each}}
  </div>
</div>
{{/if}}

<div class="coa-advanced">
  <button type="button" class="coa-advanced-toggle {{#if advanced}}is-open{{/if}}" data-action="toggleAdvanced">
    <svg width="12" height="12"><use href="#coa-ico-down"></use></svg> {{localize "CS.coa.actions.advanced"}}
  </button>
  {{#if advanced}}
  <div class="coa-advanced-body">
    <label class="coa-check"><input type="checkbox" data-coa="ordinaries.{{index}}.above" data-optional {{#if o.above}}checked{{/if}} /> <span>{{localize "CS.coa.fields.above"}}</span></label>
    {{> "systems/chroniclesystem/templates/apps/partials/coa-tincture.hbs" tincture2}}
    <div class="coa-four-col">
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.offsetX"}}</span><input type="number" step="1" data-coa="ordinaries.{{index}}.x" data-dtype="Number" data-optional data-live value="{{o.x}}" /></label>
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.offsetY"}}</span><input type="number" step="1" data-coa="ordinaries.{{index}}.y" data-dtype="Number" data-optional data-live value="{{o.y}}" /></label>
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.angle"}}</span><input type="number" step="1" data-coa="ordinaries.{{index}}.angle" data-dtype="Number" data-optional data-live value="{{o.angle}}" /></label>
      <label class="coa-field"><span class="coa-sub-label">{{localize "CS.coa.fields.stretch"}}</span><input type="number" step="0.1" data-coa="ordinaries.{{index}}.stretch" data-dtype="Number" data-optional data-live value="{{o.stretch}}" /></label>
    </div>
  </div>
  {{/if}}
</div>
