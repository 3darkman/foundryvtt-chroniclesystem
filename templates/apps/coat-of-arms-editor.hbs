{{!-- Coat of Arms editor — hifi layout (design handoff). Root is a <section>
      (NOT a <form>) per the project AppV2 rule. Icon sprite is inline. --}}
<section class="coa-body">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="coa-ico-x" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></symbol>
    <symbol id="coa-ico-plus" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></symbol>
    <symbol id="coa-ico-trash" viewBox="0 0 16 16"><path d="M3 4.5h10M6.5 4.5V3.2h3v1.3M4.3 4.5l.6 8.3h6.2l.6-8.3" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="coa-ico-grip" viewBox="0 0 16 16"><circle cx="6" cy="4" r="1.1" fill="currentColor"/><circle cx="10" cy="4" r="1.1" fill="currentColor"/><circle cx="6" cy="8" r="1.1" fill="currentColor"/><circle cx="10" cy="8" r="1.1" fill="currentColor"/><circle cx="6" cy="12" r="1.1" fill="currentColor"/><circle cx="10" cy="12" r="1.1" fill="currentColor"/></symbol>
    <symbol id="coa-ico-search" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.4" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.4 10.4L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
    <symbol id="coa-ico-save" viewBox="0 0 16 16"><path d="M3 2.6h8.2L13.4 5v8.4H3z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M5.2 2.6v3.1h4.6V2.6M5.4 13v-3.3h5.2V13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></symbol>
    <symbol id="coa-ico-shuffle" viewBox="0 0 16 16"><path d="M2 4h2.6l7 8H14M2 12h2.6l2.2-2.5M9.4 6.3L11.4 4H14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 2.2 14 4l-2 1.8M12 10.2 14 12l-2 1.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="coa-ico-up" viewBox="0 0 16 16"><path d="M4 10l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="coa-ico-down" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="coa-ico-reset" viewBox="0 0 16 16"><path d="M13 8a5 5 0 1 1-1.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M13 2.5V5H10.5" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
    <symbol id="coa-ico-noart" viewBox="0 0 16 16"><rect x="2.2" y="2.2" width="11.6" height="11.6" rx="2.4" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="2.4 2"/><path d="M6.2 6.3a1.9 1.9 0 1 1 2.9 1.7c-.8.5-1.1 1-1.1 1.9m0 2.1v.3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></symbol>
    <symbol id="gl-shield" viewBox="0 0 16 16"><path d="M8 1.6l5 1.6v4.2C13 11 8 14.4 8 14.4S3 11 3 7.4V3.2z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></symbol>
    <symbol id="gl-field" viewBox="0 0 16 16"><rect x="2.4" y="2.4" width="11.2" height="11.2" rx="1.6" fill="currentColor" opacity=".9"/></symbol>
    <symbol id="gl-division" viewBox="0 0 16 16"><rect x="2.4" y="2.4" width="11.2" height="11.2" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.6 8q1.7-1.3 3.4 0t3.4 0 3.4 0" fill="none" stroke="currentColor" stroke-width="1.3"/></symbol>
    <symbol id="gl-ord" viewBox="0 0 16 16"><rect x="2.4" y="2.4" width="11.2" height="11.2" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="2.6" y="6.4" width="10.8" height="3.2" fill="currentColor"/></symbol>
    <symbol id="gl-charge" viewBox="0 0 16 16"><path d="M8 2.3l1.6 3.5 3.8.4-2.9 2.5.9 3.7L8 10.9 4.6 12.8l.9-3.7-2.9-2.5 3.8-.4z" fill="currentColor"/></symbol>
  </svg>

  <div class="coa-grid">
    <div class="coa-col coa-col-preview">
      {{> "systems/chroniclesystem/templates/apps/partials/coa-preview.hbs"}}
    </div>

    <div class="coa-col coa-col-layers">
      {{> "systems/chroniclesystem/templates/apps/partials/coa-layers.hbs"}}
    </div>

    <div class="coa-col coa-col-inspector">
      <div class="coa-insp-header">
        <span class="coa-insp-icon"><svg width="17" height="17"><use href="#{{inspectorHeader.glyph}}"></use></svg></span>
        <div class="coa-insp-titles">
          <div class="coa-insp-name">{{inspectorHeader.name}}</div>
          <div class="coa-insp-kind">{{inspectorHeader.kind}}</div>
        </div>
      </div>
      <div class="coa-insp-body">
        {{> "systems/chroniclesystem/templates/apps/partials/coa-inspector.hbs" inspector}}
      </div>
    </div>
  </div>

  {{> "systems/chroniclesystem/templates/apps/partials/coa-footer.hbs"}}

  {{#if catalog}}
    {{> "systems/chroniclesystem/templates/apps/partials/coa-charge-catalog.hbs" catalog}}
  {{/if}}
</section>
