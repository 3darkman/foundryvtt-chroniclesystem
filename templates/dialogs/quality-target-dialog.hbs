{{!-- Which of the Unit Type's four weapon lists a dropped Quality joins (spec
      025, handoff "Aplicar qualidade"): the dropped quality named as a chip, the
      question, then the four destinations as two labelled pairs of buttons —
      one click IS the answer. The frame's footer holds only Cancel.
      All four wear the outline variant: the prototype's filled button was
      showing the hover state, not a default one. --}}
<div class="cs-quality-target-body">
    {{#if qualityName}}
    <div class="cs-quality-target-head">
        <span class="cs2-tag">{{qualityName}}</span>
    </div>
    {{/if}}
    <p class="cs-quality-target-question">{{localize "CS.dialogs.qualityTarget.question"}}</p>
    {{#each groups as |group|}}
    <div class="cs-quality-target-group">
        <div class="csv2-label">{{localize group.label}}</div>
        <div class="cs-quality-target-choices">
            {{#each group.targets as |target|}}
            <button type="button" data-target="{{target.path}}" class="csv2-btn csv2-btn--outline">{{localize target.label}}</button>
            {{/each}}
        </div>
    </div>
    {{/each}}
</div>
