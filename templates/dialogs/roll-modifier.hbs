{{!-- Roll dialog (spec 009 US2/US3). Root is a <div> (NEVER a nested <form> — the
      DialogV2 frame owns the form). The BASE inputs are read-only and carry NO
      name (v13 submits readonly inputs that HAVE a name), so only the difficulty
      selector, the optional-effect checkboxes and the user-extra inputs submit. --}}
<div class="cs-roll-dialog">
    {{!-- spec 010 (FR-004): with a target, its Combat/Intrigue Defense IS the
          difficulty — shown READ-ONLY in place of the selector (not editable).
          Without a target, the standard difficulty selector. --}}
    {{#if targetDifficulty}}
    <div class="cs-roll-difficulty cs-roll-difficulty-target">
        <label>{{localize "CS.dialogs.rollModifier.difficulty"}}</label>
        <span class="cs-difficulty-target-value"><b>{{targetDifficulty.value}}</b><em>{{targetDifficulty.name}}</em></span>
    </div>
    {{else}}
    {{#if difficultyOptions.length}}
    <div class="cs-roll-difficulty">
        <label for="difficultyIndex">{{localize "CS.dialogs.rollModifier.difficulty"}}</label>
        <select id="difficultyIndex" name="difficultyIndex">
            <option value="-1" {{#if noneSelected}}selected{{/if}}>{{localize "CS.difficulty.none"}}</option>
            {{#each difficultyOptions}}
            <option value="{{this.index}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
        </select>
    </div>
    {{/if}}
    {{/if}}

    <fieldset class="cs-roll-base">
        <legend>{{localize "CS.dialogs.rollModifier.baseTitle"}}</legend>
        <div class="cs-roll-grid">
            <label>{{localize "CS.dialogs.rollModifier.pool"}}<input type="number" value="{{base.pool}}" readonly tabindex="-1" /></label>
            <label>{{localize "CS.dialogs.rollModifier.bonusDice"}}<input type="number" value="{{base.bonusDice}}" readonly tabindex="-1" /></label>
            <label>{{localize "CS.dialogs.rollModifier.modifier"}}<input type="number" value="{{base.modifier}}" readonly tabindex="-1" /></label>
            <label>{{localize "CS.dialogs.rollModifier.dicePenalty"}}<input type="number" value="{{base.dicePenalty}}" readonly tabindex="-1" /></label>
            <label>{{localize "CS.dialogs.rollModifier.reRoll"}}<input type="number" value="{{base.reRoll}}" readonly tabindex="-1" /></label>
        </div>
    </fieldset>

    {{#if itemizedAlwaysOn.length}}
    <fieldset class="cs-roll-itemized">
        <legend>{{localize "CS.dialogs.rollModifier.itemizedTitle"}}</legend>
        {{#each itemizedAlwaysOn}}
        <div class="cs-itemized-row cs-origin-{{this.origin}}">
            <span class="cs-itemized-origin">{{this.originLabel}}</span>
            <span class="cs-itemized-source">{{this.sourceLabel}}</span>
            <span class="cs-itemized-value">{{this.displayValue}}</span>
            {{#if this.condition}}<span class="cs-itemized-condition">{{this.condition}}</span>{{/if}}
        </div>
        {{/each}}
    </fieldset>
    {{/if}}

    {{#if optionalEffects.length}}
    <fieldset class="cs-optional-effects">
        <legend>{{localize "CS.dialogs.rollModifier.optionalEffects"}}</legend>
        {{#each optionalEffects}}
        <label class="cs-optional-effect">
            <input type="checkbox" data-field="{{this.formulaField}}" data-value="{{this.value}}" data-effect-id="{{this.effectId}}" />
            <span class="cs-optional-effect-name">{{this.name}}</span>
            <span class="cs-optional-effect-value">{{this.displayValue}}</span>
            {{#if this.condition}}<span class="cs-optional-effect-condition">{{this.condition}}</span>{{/if}}
        </label>
        {{/each}}
    </fieldset>
    {{/if}}

    <fieldset class="cs-roll-extras">
        <legend>{{localize "CS.dialogs.rollModifier.extrasTitle"}}</legend>
        <p class="cs-roll-extras-hint">{{localize "CS.dialogs.rollModifier.extrasHint"}}</p>
        <div class="cs-roll-grid">
            <label>{{localize "CS.dialogs.rollModifier.pool"}}<input type="number" name="extraPool" value="0" /></label>
            <label>{{localize "CS.dialogs.rollModifier.bonusDice"}}<input type="number" name="extraBonusDice" value="0" /></label>
            <label>{{localize "CS.dialogs.rollModifier.modifier"}}<input type="number" name="extraModifier" value="0" /></label>
            <label>{{localize "CS.dialogs.rollModifier.dicePenalty"}}<input type="number" name="extraDicePenalty" value="0" /></label>
            <label>{{localize "CS.dialogs.rollModifier.reRoll"}}<input type="number" name="extraReRoll" value="0" /></label>
        </div>
    </fieldset>
</div>
